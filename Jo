<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>AI Me</title>

<style>
    * {
        box-sizing: border-box;
    }

    body {
        margin: 0;
        font-family: Arial, sans-serif;
        background: #f4f4f4;
        color: #222;
    }

    .app {
        max-width: 600px;
        margin: auto;
        min-height: 100vh;
        background: white;
        display: flex;
        flex-direction: column;
    }

    header {
        padding: 18px;
        background: #222;
        color: white;
    }

    header h1 {
        margin: 0;
        font-size: 22px;
    }

    header p {
        margin: 5px 0 0;
        opacity: .7;
        font-size: 13px;
    }

    .chat {
        flex: 1;
        padding: 15px;
        overflow-y: auto;
    }

    .message {
        margin-bottom: 12px;
        padding: 11px 14px;
        border-radius: 15px;
        max-width: 85%;
        line-height: 1.4;
        white-space: pre-wrap;
    }

    .user {
        margin-left: auto;
        background: #222;
        color: white;
        border-bottom-right-radius: 4px;
    }

    .ai {
        margin-right: auto;
        background: #eee;
        border-bottom-left-radius: 4px;
    }

    .quick-buttons {
        display: flex;
        gap: 7px;
        overflow-x: auto;
        padding: 8px 12px;
    }

    button {
        border: none;
        padding: 9px 13px;
        border-radius: 20px;
        cursor: pointer;
        background: #ddd;
        white-space: nowrap;
    }

    button:hover {
        background: #ccc;
    }

    .input-area {
        display: flex;
        gap: 8px;
        padding: 12px;
        border-top: 1px solid #ddd;
    }

    textarea {
        flex: 1;
        resize: none;
        border: 1px solid #ccc;
        border-radius: 12px;
        padding: 11px;
        font-family: inherit;
        min-height: 45px;
    }

    .send {
        background: #222;
        color: white;
        border-radius: 12px;
        padding: 0 17px;
    }

    .schedule {
        padding: 15px;
        display: none;
        overflow-y: auto;
    }

    .schedule h2 {
        margin-top: 0;
    }

    .day {
        margin-bottom: 18px;
    }

    .day h3 {
        margin-bottom: 7px;
    }

    .class {
        padding: 9px;
        background: #f1f1f1;
        border-radius: 9px;
        margin-bottom: 5px;
        font-size: 13px;
    }

    .free {
        background: #e7f7e7;
    }

    .nav {
        display: flex;
        border-top: 1px solid #ddd;
    }

    .nav button {
        flex: 1;
        border-radius: 0;
        background: white;
        padding: 13px;
    }

    .active {
        font-weight: bold;
    }
</style>
</head>

<body>

<div class="app">

<header>
    <h1>AI Me</h1>
    <p>basically me but coded 💀</p>
</header>

<div id="chat" class="chat">

    <div class="message ai">
        okay what happened 😭
    </div>

</div>

<div id="schedule" class="schedule">

    <h2>My Schedule</h2>

    <div class="day">
        <h3>Monday</h3>
        <div class="class">8–9 AM — Physics Lecture</div>
        <div class="class">9–10 AM — Math Lecture</div>
        <div class="class">10 AM–12 PM — Basic Engineering Practical</div>
        <div class="class">12–1 PM — Chemistry Lecture</div>
        <div class="class free">1–2 PM — BREAK</div>
        <div class="class">2–3 PM — Physics Tutorial</div>
        <div class="class">3–4 PM — English</div>
    </div>

    <div class="day">
        <h3>Tuesday</h3>
        <div class="class">8–9 AM — Basic Engineering Lecture</div>
        <div class="class">9–10 AM — Math Lecture</div>
        <div class="class">10–11 AM — Math Tutorial</div>
        <div class="class">11 AM–12 PM — PAI</div>
        <div class="class free">12–2 PM — BREAK</div>
        <div class="class">2–3 PM — Basic Engineering Tutorial</div>
        <div class="class">3–4 PM — Pengajian Am</div>
    </div>

    <div class="day">
        <h3>Wednesday</h3>
        <div class="class">8–10 AM — Chemistry Practical</div>
        <div class="class free">10–11 AM — FREE</div>
        <div class="class">11 AM–12 PM — Chemistry Tutorial</div>
        <div class="class">12–1 PM — English</div>
        <div class="class free">1–2 PM — BREAK</div>
        <div class="class">2–3 PM — Math Tutorial</div>
        <div class="class">3–4 PM — Basic Engineering Tutorial</div>
    </div>

    <div class="day">
        <h3>Thursday</h3>
        <div class="class">8–9 AM — Chemistry Tutorial</div>
        <div class="class">9–10 AM — English</div>
        <div class="class">10–11 AM — Physics Tutorial</div>
        <div class="class">11 AM–12 PM — Basic Engineering Tutorial</div>
        <div class="class free">12–2 PM — BREAK</div>
        <div class="class">2–4 PM — Physics Practical</div>
    </div>

    <div class="day">
        <h3>Friday</h3>
        <div class="class free">8–9 AM — FREE</div>
        <div class="class">9–10 AM — Math Tutorial</div>
        <div class="class">10–11 AM — Chemistry Tutorial</div>
        <div class="class">11 AM–12 PM — Physics Tutorial</div>
        <div class="class free">12–4 PM — FREE</div>
    </div>

</div>

<div class="quick-buttons">
    <button onclick="quick('What am I doing right now?')">what am I doing rn</button>
    <button onclick="quick('What should I reply to Luqman?')">reply to Luqman</button>
    <button onclick="quick('Am I busy today?')">am I busy</button>
    <button onclick="quick('Make this sound like me')">make it sound like me</button>
</div>

<div class="input-area">
    <textarea id="input" placeholder="say something..."></textarea>
    <button class="send" onclick="send()">send</button>
</div>

<div class="nav">
    <button class="active" onclick="showChat()">💬 Chat</button>
    <button onclick="showSchedule()">📅 Schedule</button>
</div>

</div>

<script>

const schedule = {
    Monday: [
        ["08:00","09:00","Physics Lecture"],
        ["09:00","10:00","Math Lecture"],
        ["10:00","12:00","Basic Engineering Practical"],
        ["12:00","13:00","Chemistry Lecture"],
        ["13:00","14:00","BREAK"],
        ["14:00","15:00","Physics Tutorial"],
        ["15:00","16:00","English"]
    ],

    Tuesday: [
        ["08:00","09:00","Basic Engineering Lecture"],
        ["09:00","10:00","Math Lecture"],
        ["10:00","11:00","Math Tutorial"],
        ["11:00","12:00","PAI"],
        ["12:00","14:00","BREAK"],
        ["14:00","15:00","Basic Engineering Tutorial"],
        ["15:00","16:00","Pengajian Am"]
    ],

    Wednesday: [
        ["08:00","10:00","Chemistry Practical"],
        ["10:00","11:00","FREE"],
        ["11:00","12:00","Chemistry Tutorial"],
        ["12:00","13:00","English"],
        ["13:00","14:00","BREAK"],
        ["14:00","15:00","Math Tutorial"],
        ["15:00","16:00","Basic Engineering Tutorial"]
    ],

    Thursday: [
        ["08:00","09:00","Chemistry Tutorial"],
        ["09:00","10:00","English"],
        ["10:00","11:00","Physics Tutorial"],
        ["11:00","12:00","Basic Engineering Tutorial"],
        ["12:00","14:00","BREAK"],
        ["14:00","16:00","Physics Practical"]
    ],

    Friday: [
        ["08:00","09:00","FREE"],
        ["09:00","10:00","Math Tutorial"],
        ["10:00","11:00","Chemistry Tutorial"],
        ["11:00","12:00","Physics Tutorial"],
        ["12:00","16:00","FREE"]
    ]
};


function getCurrentClass() {

    const now = new Date();

    const days = [
        "Sunday",
        "Monday",
        "Tuesday",
        "Wednesday",
        "Thursday",
        "Friday",
        "Saturday"
    ];

    const today = days[now.getDay()];

    if (!schedule[today]) {
        return "no class today 😭";
    }

    const currentMinutes =
        now.getHours() * 60 + now.getMinutes();

    for (const item of schedule[today]) {

        const start = timeToMinutes(item[0]);
        const end = timeToMinutes(item[1]);

        if (currentMinutes >= start && currentMinutes < end) {

            if (
                item[2] === "FREE" ||
                item[2] === "BREAK"
            ) {
                return `you're free rn 😭 (${item[2].toLowerCase()})`;
            }

            return `you're in ${item[2]} rn`;
        }
    }

    return "class is over for today 👍";
}


function timeToMinutes(time) {

    const [h,m] = time.split(":").map(Number);

    return h * 60 + m;
}


function addMessage(text, type) {

    const chat = document.getElementById("chat");

    const message = document.createElement("div");

    message.className = "message " + type;

    message.textContent = text;

    chat.appendChild(message);

    chat.scrollTop = chat.scrollHeight;
}


function quick(text) {

    document.getElementById("input").value = text;

    send();
}


function send() {

    const input = document.getElementById("input");

    const text = input.value.trim();

    if (!text) return;

    addMessage(text, "user");

    input.value = "";

    setTimeout(() => {

        const reply = generateReply(text);

        addMessage(reply, "ai");

    }, 300);
}


function generateReply(text) {

    const lower = text.toLowerCase();

    // CURRENT SCHEDULE

    if (
        lower.includes("right now") ||
        lower.includes("doing rn") ||
        lower.includes("doing right now")
    ) {
        return getCurrentClass();
    }


    // BUSY

    if (
        lower.includes("busy today") ||
        lower.includes("am i busy")
    ) {

        const now = new Date();

        const dayNames = [
            "Sunday",
            "Monday",
            "Tuesday",
            "Wednesday",
            "Thursday",
            "Friday",
            "Saturday"
        ];

        const today = dayNames[now.getDay()];

        if (!schedule[today]) {
            return "no classes today 😭";
        }

        return `yeah you're pretty busy today 💀 it's ${today}`;
    }


    // LUQMAN REPLY

    if (
        lower.includes("reply to luqman") ||
        lower.includes("what should i reply")
    ) {

        return `send me what he said first 😭

then i'll make the reply sound like you, not some cringe AI shit`;
    }


    // STYLE

    if (
        lower.includes("sound like me") ||
        lower.includes("make it sound like me")
    ) {

        return `short + casual + Malay/English + slightly chaotic 😭

not formal
not cringe
not suddenly romantic

basically something you'd actually type`;
    }


    // GENERIC

    if (
        lower.includes("hello") ||
        lower === "hi" ||
        lower === "hey"
    ) {
        return "g 😭";
    }


    if (lower.includes("fuck you")) {
        return "HAHAHA okay bro 😭";
    }


    return "okay but give me more context 😭";
}


function showChat() {

    document.getElementById("chat").style.display = "block";

    document.getElementById("schedule").style.display = "none";
}


function showSchedule() {

    document.getElementById("chat").style.display = "none";

    document.getElementById("schedule").style.display = "block";
}

</script>

</body>
</html>
